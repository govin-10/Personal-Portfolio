# ---------------------------------------------------------------------------
# Sanity (content dashboard)
# Get these after running `npx sanity login` and creating a project.
# Until they are set, the site renders from the local seed content in
# lib/content/local.ts — nothing breaks, you just can't edit via /studio.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=****
NEXT_PUBLIC_SANITY_DATASET=*****

# Optional: read token. Only needed for draft previews of unpublished docs.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity -> Next.js revalidation webhook.
# Generate with: openssl rand -base64 32
SANITY_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Contact form email delivery (https://resend.com - free tier is plenty)
# Without a key the form fails closed with a friendly "email me directly"
# message instead of silently dropping submissions.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=contactmail@gmail.com
# Must be a domain you've verified in Resend. onboarding@resend.dev works for testing.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Canonical site URL (used for metadata, sitemap, OG images)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://govindatimsina.com.np
